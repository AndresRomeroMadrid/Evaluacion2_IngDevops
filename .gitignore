# ==============================================================================
# GITIGNORE - PROYECTO EVALUACIÓN 2 (DEVOPS)
# ==============================================================================
# Previene la inclusión de archivos temporales, dependencias pesadas,
# reportes de pruebas, claves de entorno y archivos basura del sistema operativo.
# ==============================================================================

# Dependencias Node.js (Evita subir gigabytes de librerías)
node_modules/
**/node_modules/
package-lock.json.backup

# Archivos y cachés de Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Logs y depuración
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Cobertura y reportes de pruebas (Jest / LCOV)
coverage/
**/coverage/
.nyc_output/
*.lcov

# Variables de entorno y secretos
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Trazabilidad local y temporales de CI
.trazabilidad/
**/.trazabilidad/

# Archivos temporales y de caché de editores / IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Archivos basura del Sistema Operativo
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Docker local overrides
docker-compose.override.yml
