# ==============================================================================
# VARIABLES DE ENTORNO PARA DOCKER COMPOSE
# ==============================================================================
# Copiar a `.env` (cp .env.example .env) antes de ejecutar `docker compose`.
# El docker-compose.yml exige todas estas variables: si falta alguna, falla.
# El archivo `.env` real está excluido del control de versiones.
# ==============================================================================

# Comunes
NODE_ENV=production
PYTHONUNBUFFERED=1

# Imágenes (Docker Hub): usuario y tag. En el pipeline se sobrescriben con el
# secret DOCKERHUB_USERNAME y el SHA del commit.
DOCKERHUB_USERNAME=usuario-dockerhub
IMAGE_TAG=latest

# Microservicio de creación (Node.js)
CREATE_PORT=3001

# Microservicio de actualización (Python)
UPDATE_PORT=3002
CREATE_SERVICE_URL=http://service-create:3001

# Frontend Dashboard
FRONTEND_PORT=3000
UPDATE_SERVICE_URL=http://service-update:3002
